$otaku_app $mol_book2_catalog
	api \https://shikimori.io
	menu_title \Otaku
	param \anime
	plugins /
		<= Theme $mol_theme_auto
	menu_tools /
		<= Lights $mol_lights_toggle
		<= Source $mol_link_source
			uri \https://github.com/Egork-Dev/otaku
	menu_body /
		<= Mode $mol_switch
			options *
				catalog \Каталог
				list \Мой список
			value? <=> mode? \
		<= Query $mol_search
			query? <=> query? \
		<= Menu_links
	Menu_links_empty $mol_paragraph
		title \Ничего не нашлось
	Skeleton* $mol_view
		minimal_height 88
		attr *
			^
			aria-hidden true
	Menu_item* $mol_view
		minimal_height 88
		sub <= menu_item_content*
	menu_link_content* /
		<= Poster* $mol_image
			uri <= poster* \
		<= Menu_link_title*
	Spread* $otaku_anime
		api <= api
		anime_id <= anime_id* \
		status? <=> status*? \
		addon_tools /
			<= Spread_close
